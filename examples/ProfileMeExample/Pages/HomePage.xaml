<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scenarios="clr-namespace:ProfileMeExample.Scenarios"
             x:Class="ProfileMeExample.Pages.HomePage"
             Title="ProfileMe">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <Label Grid.Row="0"
               Text="Every screen of this app has a performance problem on purpose. Open one, make it slow, then profile it with net-android-profiler. Each screen's Guide says what to look for."
               LineBreakMode="WordWrap" />

        <CollectionView x:Name="ScenarioList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnScenarioSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="scenarios:ScenarioInfo">
                    <Border Padding="12" Margin="0,0,0,8" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding Symptom}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Feature}" FontSize="12" FontAttributes="Italic" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
