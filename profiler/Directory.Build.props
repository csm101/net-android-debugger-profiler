<Project>

  <!--
    One version for everything the product ships: the MCP server, nap, nap-weave and the
    result database's tool stamp all read it from here. ProfilerSession.ToolVersion takes
    it from the assembly rather than repeating it, so a release is a single edit.

    NapVersion is also what build/package.ps1 names the package after.
  -->
  <PropertyGroup>
    <NapVersion>0.2.0</NapVersion>
    <Version>$(NapVersion)</Version>
    <Company>MCA Software s.a.s. di Sirna Carlo &amp; C.</Company>
    <Product>net-android-profiler</Product>
    <Copyright>Copyright (c) 2026 MCA Software s.a.s. di Sirna Carlo &amp; C. All rights reserved.</Copyright>
  </PropertyGroup>

</Project>
