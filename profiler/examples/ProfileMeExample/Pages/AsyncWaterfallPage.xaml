<?xml version="1.0" encoding="utf-8" ?>
<pages:ScenarioPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:ProfileMeExample.Pages"
                    x:Class="ProfileMeExample.Pages.AsyncWaterfallPage">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Loads the week's forecast, one day per request, each awaited before the next starts. The screen stays responsive and the device stays idle; it just takes seven round trips instead of one."
               LineBreakMode="WordWrap" />
        <Button x:Name="LoadButton" Text="Load the week" Clicked="OnLoadClicked" />
        <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
        <Button Text="How to profile this" Clicked="OnGuideClicked" />
    </VerticalStackLayout>

</pages:ScenarioPage>
