<?xml version="1.0" encoding="utf-8" ?>
<pages:ScenarioPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:ProfileMeExample.Pages"
                    x:Class="ProfileMeExample.Pages.AllocationStormPage">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Exports a few thousand sales as CSV text. Nothing is kept afterwards, yet the export allocates hundreds of megabytes on the way and the garbage collector runs constantly."
               LineBreakMode="WordWrap" />
        <Button x:Name="ExportButton" Text="Export the report" Clicked="OnExportClicked" />
        <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
        <Button Text="How to profile this" Clicked="OnGuideClicked" />
    </VerticalStackLayout>

</pages:ScenarioPage>
