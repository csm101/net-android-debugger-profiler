{
  "name": "net-android-debugger",
  "displayName": ".NET for Android debugger (Mono)",
  "description": "Debug .NET for Android apps (C# on MonoVM) through the Mono Soft Debugger.",
  "version": "0.1.0",
  "publisher": "mca-software",
  "private": true,
  "license": "SEE LICENSE IN ../../../LICENSE",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:net-android"
  ],
  "contributes": {
    "configuration": {
      "title": ".NET for Android debugger",
      "properties": {
        "netAndroidDebugger.adapterPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to `NetAndroidDebugger.Dap.dll`. Leave empty to use the folder `register-mcp.cmd` publishes to (`%LOCALAPPDATA%\\net-android-debugger` on Windows, `~/.local/share/net-android-debugger` elsewhere)."
        },
        "netAndroidDebugger.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "The dotnet executable used to run the adapter."
        }
      }
    },
    "breakpoints": [
      {
        "language": "csharp"
      }
    ],
    "debuggers": [
      {
        "type": "net-android",
        "label": ".NET for Android (Mono)",
        "languages": [
          "csharp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "deviceSerial",
              "packageName"
            ],
            "properties": {
              "deviceSerial": {
                "type": "string",
                "description": "adb serial of the target device, from `adb devices`. Always explicit - there is no default device."
              },
              "packageName": {
                "type": "string",
                "description": "The app's ApplicationId, e.g. App.Droid."
              },
              "activityName": {
                "type": "string",
                "description": "pkg/fully.qualified.Activity. Resolved automatically when omitted."
              },
              "projectPath": {
                "type": "string",
                "description": "Android .csproj. Needed only with deploy."
              },
              "deploy": {
                "type": "boolean",
                "default": false,
                "description": "Build and install the app before launching."
              },
              "configuration": {
                "type": "string",
                "default": "Debug",
                "description": "msbuild configuration used for the deploy."
              },
              "basePort": {
                "type": "number",
                "default": 10000,
                "description": "First SDB port; every further process of the app takes the next one."
              },
              "propertyLifetimeSeconds": {
                "type": "number",
                "default": 180,
                "description": "How long the device-side debug property stays valid after launch."
              },
              "keepPropertyFresh": {
                "type": "boolean",
                "default": false,
                "description": "Keep the property valid for the whole session, so processes the app starts much later are debugged too. While it is on, any other Mono app starting on the device stalls waiting for a debugger on our port."
              }
            }
          },
          "attach": {
            "required": [
              "deviceSerial",
              "packageName"
            ],
            "properties": {
              "deviceSerial": {
                "type": "string",
                "description": "adb serial of the target device."
              },
              "packageName": {
                "type": "string",
                "description": "The app's ApplicationId."
              },
              "activityName": {
                "type": "string",
                "description": "pkg/fully.qualified.Activity. Resolved automatically when omitted."
              },
              "basePort": {
                "type": "number",
                "default": 10000
              },
              "keepPropertyFresh": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "net-android",
            "request": "launch",
            "name": "Android app (restart under debugger)",
            "deviceSerial": "emulator-5554",
            "packageName": "com.example.app"
          }
        ],
        "configurationSnippets": [
          {
            "label": ".NET for Android: launch",
            "description": "Restart an installed app with the Mono debugger agent and attach.",
            "body": {
              "type": "net-android",
              "request": "launch",
              "name": "${2:Android app}",
              "deviceSerial": "${1:emulator-5554}",
              "packageName": "${3:com.example.app}"
            }
          },
          {
            "label": ".NET for Android: build, install and launch",
            "description": "Deploy the project first, then attach.",
            "body": {
              "type": "net-android",
              "request": "launch",
              "name": "${2:Android app (deploy)}",
              "deviceSerial": "${1:emulator-5554}",
              "packageName": "${3:com.example.app}",
              "projectPath": "^\"\\${workspaceFolder}/${4:App}/${4:App}.csproj\"",
              "deploy": true
            }
          }
        ]
      }
    ]
  }
}
