<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The rules-file reader is a frontend concern; the tests exercise it directly. -->
    <Compile Include="../../src/NetAndroidDebugger.Shared/ExceptionRuleFile.cs" Link="Harness/ExceptionRuleFile.cs" />
    <Compile Include="../../src/NetAndroidDebugger.Shared/LaunchConfigFile.cs" Link="Harness/LaunchConfigFile.cs" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetAndroidDebugger.Core\NetAndroidDebugger.Core.csproj" />
    <!-- Build dependency only: McpEndToEndTests spawns the server dll from its own output folder. -->
    <ProjectReference Include="..\..\src\NetAndroidDebugger.Mcp\NetAndroidDebugger.Mcp.csproj" ReferenceOutputAssembly="false" />
    <!-- Same for the DAP adapter: DapEndToEndTests starts it as a process. -->
    <ProjectReference Include="..\..\src\NetAndroidDebugger.Dap\NetAndroidDebugger.Dap.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NetAndroid.Device" />
  </ItemGroup>

</Project>
