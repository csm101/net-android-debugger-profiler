<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- One reader, both frontends: the file format is a frontend concern, Core stays JSON-free. -->
    <Compile Include="../NetAndroidDebugger.Shared/ExceptionRuleFile.cs" Link="ExceptionRuleFile.cs" />
    <ProjectReference Include="..\NetAndroidDebugger.Core\NetAndroidDebugger.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NetAndroidDebugger.Dap</AssemblyName>
    <RootNamespace>NetAndroidDebugger.Dap</RootNamespace>
  </PropertyGroup>

</Project>
