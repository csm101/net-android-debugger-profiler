<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored mono/debugger-libs (git submodule, read-only upstream). -->
    <ProjectReference Include="..\..\ThirdParty\debugger-libs\Mono.Debugging.Soft\Mono.Debugging.Soft.csproj" />
    <ProjectReference Include="..\..\ThirdParty\debugger-libs\Mono.Debugging\Mono.Debugging.csproj" />
    <ProjectReference Include="..\..\ThirdParty\debugger-libs\Mono.Debugger.Soft\Mono.Debugger.Soft.csproj" />
    <!-- Mono.Debugger.Soft references Mono.Cecil with PrivateAssets="all" (upstream choice); it is still needed at runtime
         (MethodMirror.GetCustomAttributes under ENABLE_CECIL), so every consumer must reference it explicitly. -->
    <PackageReference Include="Mono.Cecil" Version="0.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The device layer both products share: adb, the device, the app's environment on it. -->
    <ProjectReference Include="..\NetAndroid.Device\NetAndroid.Device.csproj" />
    <Using Include="NetAndroid.Device" />
  </ItemGroup>

</Project>
