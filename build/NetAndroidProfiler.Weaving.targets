<Project>

  <!--
    Build-time IL weaving for net-android-profiler.

    Import this file from an Android app project (or from Directory.Build.targets)
    and build with -p:NapWeave=true to produce an instrumented app. Needed only for
    apps that ship their assemblies inside the APK (EmbedAssembliesIntoApk=true),
    where the profiler cannot rewrite the deployed copies on the device; a normal
    fast-deployment Debug build does not need this file at all.

        <Import Project="$(NetAndroidProfilerDir)build\NetAndroidProfiler.Weaving.targets" />

        dotnet build -c Debug -t:Install \
          -p:EnableDiagnostics=true -p:NapWeave=true \
          -p:NapCallspec="T:My.App.Services.SyncService"

    Only the Android application project is woven: the targets check
    $(AndroidApplication), so importing this file for the whole build (e.g. with
    -p:CustomAfterMicrosoftCommonTargets=...) leaves referenced class libraries alone.

    Properties:
      NapWeave        true to weave this build (default: false)
      NapMode         tree (default) or trace: how the app records what it measures. The
                      session reads it from the map and follows it.
      NapCallspec     which methods to weave (same grammar as the profiler's
                      callspec: all, N:Namespace, T:Type, M:Type:Method, '-' excludes).
                      Keep it narrow: instrumenting thousands of methods makes
                      startup unusably slow.
      NapWeaveTool    path to nap-weave.dll (default: build/tools next to this file, which is
                      what a package has; the profiler's own frontends pass it explicitly,
                      because they already know where their binaries are)
      NapMapPath      where the id map is written (default: $(OutDir)nap-weave.map)
      NapAssemblies   names of referenced assemblies to weave as well as the app's own,
                      semicolon separated (App.Core;App.GeoLocation). An app is more
                      than its own assembly - the business logic usually lives in a
                      library - and a callspec that reaches one instruments nothing
                      unless it is named here. They are woven in the output folder, which
                      is what the packaging picks up.
      NapExtraAssemblies  additional assemblies to weave (semicolon separated paths)
      NapWeaveArgs    extra arguments passed straight to nap-weave (see its
                      help for the option names, e.g. allocation tracking)

    Republish the tool (dotnet publish src/NetAndroidProfiler.Weave -c Release -o
    build/tools) after updating the profiler: the build uses the published copy,
    not the source tree.

    The app's own assembly is woven in the intermediate output, before the Android
    packaging steps, so both embedded and fast-deployed layouts get the woven code.
    The collector assembly is copied next to the output and referenced so that the
    packaging includes it.
  -->

  <PropertyGroup>
    <NapWeave Condition="'$(NapWeave)' == ''">false</NapWeave>
    <NapCallspec Condition="'$(NapCallspec)' == ''"></NapCallspec>
    <NapWeaveTool Condition="'$(NapWeaveTool)' == ''">$(MSBuildThisFileDirectory)tools\nap-weave.dll</NapWeaveTool>
    <!--
      How the woven app records: tree (a calling context tree kept in the app - the
      cheapest, and what a session's automatic choice picks) or trace (an event per call,
      which keeps the order of the calls and every single duration). A build-time weave
      bakes this into the app's environment, so a session cannot change it afterwards:
      the map records it and the session follows.
    -->
    <NapMode Condition="'$(NapMode)' == ''">tree</NapMode>
    <NapCollectorAssembly Condition="'$(NapCollectorAssembly)' == ''">$(MSBuildThisFileDirectory)tools\NetAndroidProfiler.Collector.dll</NapCollectorAssembly>
    <!-- NapMapPath defaults to $(OutDir)nap-weave.map, but OutDir is only known later:
         it is computed inside the target below. -->
  </PropertyGroup>

  <!--
    The woven app must know where to write its events. Injecting that variable on the
    device means writing into files/.__override__/, which an app with embedded
    assemblies must not have (the runtime then expects to find its assemblies there
    and stops starting), so the environment is baked into this build instead. The
    path follows the same convention the profiler reads.
  -->
  <Target Name="NapWriteEnvironment"
          Condition="'$(NapWeave)' == 'true' and '$(AndroidApplication)' == 'true'"
          BeforeTargets="_GenerateJavaStubs;_GenerateEnvironmentFiles">
    <PropertyGroup>
      <_NapEnvFile>$(IntermediateOutputPath)nap-profiler.env</_NapEnvFile>
      <_NapEventsDir>/data/user/0/$(ApplicationId)/files/nap-events</_NapEventsDir>
      <_NapFilesDir>/data/user/0/$(ApplicationId)/files</_NapFilesDir>
    </PropertyGroup>
    <WriteLinesToFile File="$(_NapEnvFile)"
                      Lines="NAP_PROFILER_OUT=$(_NapEventsDir);NAP_PROFILER_MARKER_DIR=$(_NapFilesDir);NAP_PROFILER_MODE=$(NapMode)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <AndroidEnvironment Include="$(_NapEnvFile)" />
      <FileWrites Include="$(_NapEnvFile)" />
    </ItemGroup>
  </Target>

  <!-- The collector must be part of the app so the woven calls resolve at run time. -->
  <ItemGroup Condition="'$(NapWeave)' == 'true' and '$(AndroidApplication)' == 'true'">
    <Reference Include="NetAndroidProfiler.Collector">
      <HintPath>$(NapCollectorAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="NapValidateWeaving" Condition="'$(NapWeave)' == 'true' and '$(AndroidApplication)' == 'true'">
    <Error Condition="'$(NapMode)' != 'tree' and '$(NapMode)' != 'trace'"
           Text="NapMode is '$(NapMode)': it must be tree (a call tree kept in the app) or trace (an event per call)." />
    <Error Condition="'$(NapCallspec)' == ''"
           Text="NapWeave is true but NapCallspec is empty. Pass -p:NapCallspec=&quot;T:My.App.Type&quot; (or N:My.Namespace). Weaving everything makes the app unusably slow." />
    <Error Condition="!Exists('$(NapWeaveTool)')"
           Text="nap-weave was not found at $(NapWeaveTool). From a source tree, build the solution or publish the tool: dotnet publish src/NetAndroidProfiler.Weave -c Release -o build/tools. Otherwise set NapWeaveTool to the nap-weave.dll to use." />
    <Error Condition="!Exists('$(NapCollectorAssembly)')"
           Text="The collector assembly was not found at $(NapCollectorAssembly). From a source tree, build the solution; otherwise set NapCollectorAssembly to the NetAndroidProfiler.Collector.dll to use." />
  </Target>

  <!--
    The libraries, second pass. The app's own assembly is woven in the intermediate output
    before packaging; a referenced assembly is packaged from the copy in $(OutDir), so that
    is the one to rewrite, once it is there. The map is appended to rather than replaced:
    the session needs a single map holding the app and its libraries.
  -->
  <Target Name="NapWeaveReferencedAssemblies"
          Condition="'$(NapWeave)' == 'true' and '$(AndroidApplication)' == 'true' and '$(NapAssemblies)' != ''"
          DependsOnTargets="NapValidateWeaving"
          AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <NapMapPath Condition="'$(NapMapPath)' == ''">$(OutDir)nap-weave.map</NapMapPath>
    </PropertyGroup>
    <ItemGroup>
      <NapNamedAssembly Include="$(NapAssemblies)" />
      <NapNamedAssemblyFile Include="@(NapNamedAssembly->'$(OutDir)%(Identity).dll')"
                            Condition="Exists('$(OutDir)%(Identity).dll')" />
      <NapReferenceDirs2 Include="@(ReferencePath->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <Warning Condition="'@(NapNamedAssemblyFile)' == ''"
             Text="NapAssemblies names $(NapAssemblies), but none of them is in $(OutDir): nothing more was woven." />
    <Exec Condition="'@(NapNamedAssemblyFile)' != ''"
          Command="dotnet &quot;$(NapWeaveTool)&quot; @(NapNamedAssemblyFile->'--assembly &quot;%(Identity)&quot;', ' ') --callspec &quot;$(NapCallspec)&quot; --mode $(NapMode) --append $(NapWeaveArgs) --map &quot;$(NapMapPath)&quot; --collector-out &quot;$(OutDir).&quot; @(NapReferenceDirs2->'--reference-dir &quot;%(Identity).&quot;', ' ')"
          StandardOutputImportance="high" />
  </Target>

  <!--
    Runs after the compiler has produced the intermediate assembly and before anything
    copies or packages it. The tool keeps a .naporig backup and always weaves from it,
    so incremental builds never double-instrument.
  -->
  <Target Name="NapWeaveAssemblies"
          Condition="'$(NapWeave)' == 'true' and '$(AndroidApplication)' == 'true'"
          DependsOnTargets="NapValidateWeaving"
          AfterTargets="CoreCompile">
    <PropertyGroup>
      <NapMapPath Condition="'$(NapMapPath)' == ''">$(OutDir)nap-weave.map</NapMapPath>
      <_NapAssemblyArgs>--assembly "@(IntermediateAssembly->'%(FullPath)')"</_NapAssemblyArgs>
      <_NapExtraArgs Condition="'$(NapExtraAssemblies)' != ''">@(NapExtraAssemblyItems->'--assembly "%(Identity)"', ' ')</_NapExtraArgs>
    </PropertyGroup>
    <ItemGroup>
      <NapExtraAssemblyItems Include="$(NapExtraAssemblies)" />
      <NapReferenceDirs Include="@(ReferencePath->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)" />
    <!--
      Directory arguments end with a path separator, and a backslash before the closing
      quote would escape it for the command processor: a trailing "." keeps the path
      valid and the quoting intact.
    -->
    <Exec Command="dotnet &quot;$(NapWeaveTool)&quot; $(_NapAssemblyArgs) $(_NapExtraArgs) --callspec &quot;$(NapCallspec)&quot; --mode $(NapMode) $(NapWeaveArgs) --map &quot;$(NapMapPath)&quot; --collector-out &quot;$(OutDir).&quot; @(NapReferenceDirs->'--reference-dir &quot;%(Identity).&quot;', ' ')"
          StandardOutputImportance="high" />
    <ItemGroup>
      <FileWrites Include="$(NapMapPath)" />
    </ItemGroup>
  </Target>

</Project>
